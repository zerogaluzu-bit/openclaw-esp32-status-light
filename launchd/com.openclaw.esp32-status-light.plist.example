<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openclaw.esp32-status-light</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/python3</string>
    <string>/ABSOLUTE/PATH/TO/host/bridge.py</string>
    <string>--session-key</string>
    <string>REPLACE_WITH_OPENCLAW_SESSION_KEY</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/LOGS/openclaw-status-light.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/LOGS/openclaw-status-light.error.log</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
